  // Delete Action Handlers
  let pendingDeleteType = null;
  let pendingDeleteId = null;

  window.confirmDeleteEntry = function(type, id) {
    pendingDeleteType = type;
    pendingDeleteId = id;
    document.getElementById('modal-delete-confirm')?.classList.remove('hidden');
    document.getElementById('modal-delete-confirm')?.classList.add('flex');
  };

  window.closeDeleteConfirmModal = function() {
    pendingDeleteType = null;
    pendingDeleteId = null;
    document.getElementById('modal-delete-confirm')?.classList.add('hidden');
    document.getElementById('modal-delete-confirm')?.classList.remove('flex');
  };

  window.executeDeleteEntry = async function() {
    if (!pendingDeleteType || !pendingDeleteId) return;

    const id = pendingDeleteId;
    const type = pendingDeleteType;
    closeDeleteConfirmModal();

    // Remove from DOM
    const el = document.querySelector(`[data-entry-id="${id}"]`);
    if (el) el.remove();

    // Remove from local storage
    deleteCustomItem(type, id);
    updateTabBadge(type === 'resources' ? 'resources' : type, -1);
    window.showToast('Diary entry deleted successfully', 'success');

    // Call API delete
    try {
      await fetch(`/api/faculty/${type}?id=${encodeURIComponent(id)}`, {
        method: 'DELETE',
      });
    } catch (e) {}
  };

