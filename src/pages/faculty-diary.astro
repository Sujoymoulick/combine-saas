  window.submitSyllabusForm = async function() {
    const editId = document.getElementById('syl-edit-id')?.value;
    const title = document.getElementById('syl-title')?.value;
    const progress = parseInt(document.getElementById('syl-progress')?.value || '0');
    const topicsRaw = document.getElementById('syl-topics')?.value || '';

    if (!title) {
      window.showToast('Please enter the Unit Title', 'error');
      return;
    }

    const btn = document.getElementById('syl-submit-btn');
    if (btn) btn.textContent = editId ? 'Updating...' : 'Saving...';

    const topics = topicsRaw.split(',').map(t => t.trim()).filter(Boolean).map(name => ({ name, completed: false }));

    const item = {
      id: editId || 'sy_' + Date.now(),
      unit_title: title,
      progress: Math.min(100, Math.max(0, progress)),
      topics,
    };

    const container = document.getElementById('syllabus-container');
    if (container) renderSyllabusCard(item, container);
    saveCustomItem('syllabus', item);
    if (!editId) updateTabBadge('syllabus', 1);

