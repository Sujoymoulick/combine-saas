<script is:inline>
  // Quick Add Split Button & Dropdown Handlers
  window.openActiveTabModal = function() {
    if (activeTabKey === 'schedule') openAddScheduleModal();
    else if (activeTabKey === 'syllabus') openAddSyllabusModal();
    else if (activeTabKey === 'remarks') openAddRemarkModal();
    else if (activeTabKey === 'resources') openAddMaterialModal();
    else if (activeTabKey === 'research') openAddResearchModal();
  };

  window.toggleQuickAddDropdown = function(e) {
    e.stopPropagation();
    const dd = document.getElementById('quick-add-dropdown');
    if (dd) dd.classList.toggle('hidden');
  };

  window.hideQuickAddDropdown = function() {
    document.getElementById('quick-add-dropdown')?.classList.add('hidden');
  };

  document.addEventListener('click', (e) => {
    if (!e.target.closest('#quick-add-dropdown')) {
      hideQuickAddDropdown();
    }
  });

  // Diary Tabs Switching
  const diaryTabBtns = document.querySelectorAll('.diary-tab-btn');
  const diaryPanes = document.querySelectorAll('.diary-pane');

  let activeTabKey = 'schedule';

  diaryTabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-diary-tab');
      activeTabKey = target;

      diaryTabBtns.forEach((b) => {
        b.classList.remove('bg-ink', 'text-white', 'shadow-sm', 'active-diary-tab');
        b.classList.add('bg-white', 'border-hairline', 'text-slate-600');
      });
      btn.classList.add('bg-ink', 'text-white', 'shadow-sm', 'active-diary-tab');
      btn.classList.remove('bg-white', 'border-hairline', 'text-slate-600');

      diaryPanes.forEach((p) => p.classList.add('hidden'));
      const active = document.getElementById('diary-pane-' + target);
      if (active) active.classList.remove('hidden');

      filterActiveTabEntries();
    });
  });

  // Local Storage Helper
  function getCustomItems(type) {
    try {
      const raw = localStorage.getItem('faculty_diary_' + type);
      return raw ? JSON.parse(raw) : [];
    } catch (e) {
      return [];
    }
  }

  function saveCustomItem(type, item) {
    try {
      const items = getCustomItems(type);
      const index = items.findIndex(i => i.id && i.id === item.id);
      if (index >= 0) {
        items[index] = item;
      } else {
        items.unshift(item);
      }
      localStorage.setItem('faculty_diary_' + type, JSON.stringify(items));
    } catch (e) {}
  }

  function deleteCustomItem(type, id) {
    try {
      const items = getCustomItems(type).filter(i => i.id !== id);
      localStorage.setItem('faculty_diary_' + type, JSON.stringify(items));
    } catch (e) {}
  }

  // Render saved custom items on DOM load
  document.addEventListener('DOMContentLoaded', () => {
    // Render custom schedules
    const customSchedules = getCustomItems('schedule');
    const scheduleGrid = document.getElementById('schedule-grid');
    if (scheduleGrid && customSchedules.length > 0) {
      customSchedules.forEach((item) => renderScheduleCard(item, scheduleGrid));
      updateTabBadge('schedule', customSchedules.length);
    }

    // Render custom syllabus
    const customSyllabus = getCustomItems('syllabus');
    const syllabusContainer = document.getElementById('syllabus-container');
    if (syllabusContainer && customSyllabus.length > 0) {
      customSyllabus.forEach((item) => renderSyllabusCard(item, syllabusContainer));
      updateTabBadge('syllabus', customSyllabus.length);
    }

    // Render custom remarks
    const customRemarks = getCustomItems('remarks');
    const remarksContainer = document.getElementById('remarks-container');
    if (remarksContainer && customRemarks.length > 0) {
      customRemarks.forEach((item) => renderRemarkCard(item, remarksContainer));
      updateTabBadge('remarks', customRemarks.length);
    }

    // Render custom materials
    const customMaterials = getCustomItems('materials');
    const materialsGrid = document.getElementById('materials-grid');
    if (materialsGrid && customMaterials.length > 0) {
      customMaterials.forEach((item) => renderMaterialCard(item, materialsGrid));
      updateTabBadge('resources', customMaterials.length);
    }

    // Render custom research
    const customResearch = getCustomItems('research');
    const researchContainer = document.getElementById('research-container');
    if (researchContainer && customResearch.length > 0) {
      customResearch.forEach((item) => renderResearchCard(item, researchContainer));
      updateTabBadge('research', customResearch.length);
    }
  });

  function updateTabBadge(tabKey, addedCount) {
    const btn = document.querySelector(`[data-diary-tab="${tabKey}"]`);
    if (!btn) return;
    const text = btn.textContent;
    const match = text.match(/\((\d+)\)/);
    if (match) {
      const current = parseInt(match[1]);
      const updated = Math.max(0, current + addedCount);
      btn.textContent = text.replace(/\(\d+\)/, `(${updated})`);
    }
  }

  function clearEmptyState(emptyStateId, container) {
    const emptyState = document.getElementById(emptyStateId);
    if (emptyState) emptyState.remove();
  }

  // Filter & Search Functionality
  window.filterActiveTabEntries = function() {
    const query = document.getElementById('diary-search-input')?.value.toLowerCase().trim() || '';
    const activePane = document.getElementById('diary-pane-' + activeTabKey);
    if (!activePane) return;

    const items = activePane.querySelectorAll('.diary-entry-item');
    items.forEach((item) => {
      const searchText = item.getAttribute('data-search-text')?.toLowerCase() || item.textContent.toLowerCase();
      if (!query || searchText.includes(query)) {
        item.classList.remove('hidden');
      } else {
        item.classList.add('hidden');
      }
    });
  };

  // Sort Functionality
  window.sortActiveTabEntries = function() {
    const sortVal = document.getElementById('diary-sort-select')?.value;
    const activePane = document.getElementById('diary-pane-' + activeTabKey);
    if (!activePane) return;

    const container = activePane.querySelector('.grid, #syllabus-container, #remarks-container, #research-container');
    if (!container) return;

    const items = Array.from(container.querySelectorAll('.diary-entry-item'));
    items.sort((a, b) => {
      if (sortVal === 'title') {
        const tA = a.querySelector('h3, .font-bold')?.textContent || '';
        const tB = b.querySelector('h3, .font-bold')?.textContent || '';
        return tA.localeCompare(tB);
      }
      return 0; // Default DOM order
    });

    if (sortVal === 'oldest') items.reverse();
    items.forEach((item) => container.appendChild(item));
  };

  // SVG Icon Templates for Dynamic DOM Rendering
  const editIconSvg = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z" /></svg>';
  const trashIconSvg = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /><line x1="10" y1="11" x2="10" y2="17" /><line x1="14" y1="11" x2="14" y2="17" /></svg>';
  const dlIconSvg = '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>';

  // DOM Renderers for Items
  function renderScheduleCard(item, container) {
    clearEmptyState('schedule-empty-state', container);
    if (!container.classList.contains('grid')) {
      container.className = 'grid md:grid-cols-2 lg:grid-cols-3 gap-4';
    }

    const existing = container.querySelector(`[data-entry-id="${item.id}"]`);
    if (existing) existing.remove();

    const card = document.createElement('div');
    card.setAttribute('data-entry-id', item.id);
    card.setAttribute('data-search-text', `${item.course_name} ${item.topic} ${item.day_of_week} ${item.room}`);
    card.className = 'card-hover p-5 flex flex-col justify-between border-2 border-brand-blue/30 diary-entry-item';
    card.innerHTML = `
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-bold uppercase px-3 py-0.5 rounded-full bg-indigo-50 text-brand-blue border border-indigo-200">
            ${item.day_of_week}
          </span>
          <div class="flex items-center gap-1.5">
            <span class="text-[10px] text-slate-500 font-mono font-medium bg-surface px-2 py-0.5 rounded-full border border-hairline">
              ${item.room || 'Room'}
            </span>
            <button onclick="openEditScheduleModal('${item.id}', '${encodeURIComponent(JSON.stringify(item))}')" class="text-slate-400 hover:text-ink p-1 rounded hover:bg-slate-100 transition-colors" title="Edit">${editIconSvg}</button>
            <button onclick="confirmDeleteEntry('schedule', '${item.id}')" class="text-slate-400 hover:text-rose-600 p-1 rounded hover:bg-rose-50 transition-colors" title="Delete">${trashIconSvg}</button>
          </div>
        </div>
        <h3 class="font-bold text-sm text-ink mb-1">${item.course_name}</h3>
        <p class="text-xs text-slate-600 font-medium mb-3">Topic: <strong class="text-ink">${item.topic || 'General Lecture'}</strong></p>
