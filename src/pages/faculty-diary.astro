---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import {
  getFacultyTimetable,
  getSyllabusUnits,
  getMentorshipRemarks,
  getCourseMaterials,
  getResearchPapers,
} from '../lib/supabase';

const { userId } = Astro.locals.auth();
const activeUserId = userId || 'guest_user';

const [schedule, syllabusUnits, remarks, resources, researchPapers] = await Promise.all([
  getFacultyTimetable(activeUserId),
  getSyllabusUnits(activeUserId),
  getMentorshipRemarks(activeUserId),
  getCourseMaterials(activeUserId),
  getResearchPapers(activeUserId),
]);
---

<BaseLayout title="Faculty Academic Diary" activePage="faculty-diary">
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-50 border border-rose-200 text-xs text-brand-coral-dark font-semibold mb-2">
        <Icon name="diary" size={13} />
        <span>Academic Operations & Mentorship Suite</span>
      </div>
      <h1 class="text-3xl font-extrabold text-ink tracking-tight">Faculty Academic Diary</h1>
      <p class="text-slate-600 text-sm mt-1">Manage weekly timetable, track curriculum completion, record student mentorship, upload course materials, and publish research & grants.</p>
    </div>

    <!-- Header Quick Action -->
    <div class="relative shrink-0">
      <div class="inline-flex items-center rounded-2xl shadow-sm bg-ink text-white p-0.5 border border-ink">
        <button
          onclick="openActiveTabModal()"
          class="px-4 py-2 text-xs font-bold hover:bg-slate-800 rounded-xl transition-colors flex items-center gap-1.5 cursor-pointer"
        >
          <Icon name="plus" size={13} />
          <span>Add Entry</span>
        </button>
        <button
          onclick="toggleQuickAddDropdown(event)"
          class="px-2.5 py-2 text-xs border-l border-slate-700 hover:bg-slate-800 rounded-r-xl transition-colors cursor-pointer"
          title="Choose entry category"
        >
          <Icon name="chevron-down" size={13} />
        </button>
      </div>

      <!-- Quick Add Dropdown Menu -->
      <div
        id="quick-add-dropdown"
        class="hidden absolute right-0 mt-2 w-56 bg-white border border-hairline rounded-2xl shadow-modal z-50 p-2 text-xs font-semibold"
      >
        <button onclick="openAddScheduleModal(); hideQuickAddDropdown();" class="w-full text-left px-3 py-2 hover:bg-surface rounded-xl flex items-center gap-2 text-slate-700 hover:text-ink cursor-pointer">
          <Icon name="calendar" size={15} class="text-indigo-600" />
          <span>Add Timetable Entry</span>
        </button>
        <button onclick="openAddSyllabusModal(); hideQuickAddDropdown();" class="w-full text-left px-3 py-2 hover:bg-surface rounded-xl flex items-center gap-2 text-slate-700 hover:text-ink cursor-pointer">
          <Icon name="analytics" size={15} class="text-brand-blue" />
          <span>Add Syllabus Unit</span>
        </button>
        <button onclick="openAddRemarkModal(); hideQuickAddDropdown();" class="w-full text-left px-3 py-2 hover:bg-surface rounded-xl flex items-center gap-2 text-slate-700 hover:text-ink cursor-pointer">
          <Icon name="message-square" size={15} class="text-emerald-600" />
          <span>Add Student Remark</span>
        </button>
        <button onclick="openAddMaterialModal(); hideQuickAddDropdown();" class="w-full text-left px-3 py-2 hover:bg-surface rounded-xl flex items-center gap-2 text-slate-700 hover:text-ink cursor-pointer">
          <Icon name="folder" size={15} class="text-amber-600" />
          <span>Add Course Material</span>
        </button>
        <button onclick="openAddResearchModal(); hideQuickAddDropdown();" class="w-full text-left px-3 py-2 hover:bg-surface rounded-xl flex items-center gap-2 text-slate-700 hover:text-ink cursor-pointer">
          <Icon name="microscope" size={15} class="text-rose-600" />
          <span>Add Research Paper / Grant</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Search & Filter Bar -->
  <div class="card-base p-4 mb-6 flex flex-col sm:flex-row items-center justify-between gap-3">
    <div class="relative w-full sm:w-80">
      <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
        <Icon name="search" size={14} />
      </div>
      <input
        id="diary-search-input"
        type="text"
        placeholder="Search entries by course, student, paper, or topic..."
        class="input-base w-full text-xs pl-8 pr-3 py-2"
        oninput="filterActiveTabEntries()"
      />
    </div>
    <div class="flex items-center gap-2 text-xs text-slate-500 font-medium">
      <span>Sort entries:</span>
      <select id="diary-sort-select" class="input-base text-xs py-1.5 px-2 font-semibold cursor-pointer" onchange="sortActiveTabEntries()">
        <option value="newest">Newest First</option>
        <option value="oldest">Oldest First</option>
        <option value="title">Alphabetical</option>
      </select>
    </div>
  </div>

  <!-- Diary Tabs Navigation (DESIGN.md pill-tab style) -->
  <div class="flex flex-wrap gap-2 pb-4 mb-6 border-b border-hairline">
    <button data-diary-tab="schedule" class="diary-tab-btn px-4 py-2 rounded-full text-xs font-semibold bg-ink text-white active-diary-tab shadow-sm cursor-pointer inline-flex items-center gap-2">
      <Icon name="calendar" size={14} />
      <span>Weekly Timetable ({schedule ? schedule.length : 0})</span>
    </button>
    <button data-diary-tab="syllabus" class="diary-tab-btn px-4 py-2 rounded-full text-xs font-semibold bg-white border border-hairline text-slate-600 hover:text-ink cursor-pointer hover:bg-surface inline-flex items-center gap-2">
      <Icon name="analytics" size={14} />
      <span>Syllabus Coverage ({syllabusUnits ? syllabusUnits.length : 0})</span>
    </button>
    <button data-diary-tab="remarks" class="diary-tab-btn px-4 py-2 rounded-full text-xs font-semibold bg-white border border-hairline text-slate-600 hover:text-ink cursor-pointer hover:bg-surface inline-flex items-center gap-2">
      <Icon name="message-square" size={14} />
      <span>Mentorship & Remarks ({remarks ? remarks.length : 0})</span>
    </button>
    <button data-diary-tab="resources" class="diary-tab-btn px-4 py-2 rounded-full text-xs font-semibold bg-white border border-hairline text-slate-600 hover:text-ink cursor-pointer hover:bg-surface inline-flex items-center gap-2">
      <Icon name="folder" size={14} />
      <span>Course Materials ({resources ? resources.length : 0})</span>
    </button>
    <button data-diary-tab="research" class="diary-tab-btn px-4 py-2 rounded-full text-xs font-semibold bg-white border border-hairline text-slate-600 hover:text-ink cursor-pointer hover:bg-surface inline-flex items-center gap-2">
      <Icon name="microscope" size={14} />
      <span>Research & Grants ({researchPapers ? researchPapers.length : 0})</span>
    </button>
  </div>

  <!-- TAB 1: WEEKLY TIMETABLE -->
  <div id="diary-pane-schedule" class="diary-pane space-y-4">
    <div class="flex items-center justify-between bg-surface p-4 rounded-2xl border border-hairline mb-4">
      <div>
        <h2 class="font-bold text-base text-ink">Weekly Academic Timetable</h2>
        <p class="text-xs text-slate-500">Organize your weekly lectures, lab sessions, and academic office hours.</p>
      </div>
      <button onclick="openAddScheduleModal()" class="btn-primary text-xs py-2 px-3.5 inline-flex items-center gap-1.5 cursor-pointer">
        <Icon name="plus" size={13} />
        <span>Add Timetable Entry</span>
      </button>
    </div>

    <div id="schedule-grid" class={schedule && schedule.length > 0 ? "grid md:grid-cols-2 lg:grid-cols-3 gap-4" : "space-y-4"}>
      {schedule && schedule.length > 0 ? (
        schedule.map((item: any) => (
          <div data-entry-id={item.id} data-search-text={`${item.course_name} ${item.topic} ${item.day_of_week} ${item.room}`} class="card-hover p-5 flex flex-col justify-between diary-entry-item">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-bold uppercase px-3 py-0.5 rounded-full bg-indigo-50 text-brand-blue border border-indigo-200">
                  {item.day_of_week}
                </span>
                <div class="flex items-center gap-1.5">
                  <span class="text-[10px] text-slate-500 font-mono font-medium bg-surface px-2 py-0.5 rounded-full border border-hairline">
                    {item.room || 'Room 3B'}
                  </span>
                  <button onclick={`openEditScheduleModal('${item.id}', '${encodeURIComponent(JSON.stringify(item))}')`} class="text-slate-400 hover:text-ink p-1 rounded hover:bg-slate-100 transition-colors" title="Edit entry">
                    <Icon name="edit" size={13} />
                  </button>
                  <button onclick={`confirmDeleteEntry('schedule', '${item.id}')`} class="text-slate-400 hover:text-rose-600 p-1 rounded hover:bg-rose-50 transition-colors" title="Delete entry">
                    <Icon name="trash" size={13} />
                  </button>
                </div>
              </div>
              <h3 class="font-bold text-sm text-ink mb-1">{item.course_name}</h3>
              <p class="text-xs text-slate-600 font-medium mb-3">Topic: <strong class="text-ink">{item.topic || 'General Lecture'}</strong></p>
              {item.session_type && (
                <span class="inline-block text-[10px] font-semibold text-slate-500 uppercase tracking-wider bg-slate-100 px-2 py-0.5 rounded-md mb-2">
                  {item.session_type}
                </span>
              )}
            </div>
            <div class="pt-3 border-t border-hairline flex items-center justify-between text-xs">
              <span class="text-slate-500 font-mono text-[11px] font-medium">{item.time_slot}</span>
              <a href="/attendance" class="text-[11px] font-bold text-brand-blue hover:underline flex items-center gap-1">
                <span>Take Attendance</span>
                <Icon name="arrow-right" size={12} />
              </a>
            </div>
          </div>
        ))
      ) : (
        <div id="schedule-empty-state" class="card-base p-12 text-center text-slate-500 space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-surface border border-hairline flex items-center justify-center mx-auto text-slate-400">
            <Icon name="calendar" size={24} />
          </div>
          <h3 class="font-bold text-sm text-ink">No Lecture Timetable Scheduled</h3>
          <p class="text-xs text-slate-600 max-w-sm mx-auto">Your schedule is currently empty. Click below to add your weekly lectures.</p>
          <button onclick="openAddScheduleModal()" class="btn-primary text-xs py-2 px-4 inline-flex items-center gap-1.5 mt-2 cursor-pointer">
            <Icon name="plus" size={13} />
            <span>Add First Timetable Entry</span>
          </button>
        </div>
      )}
    </div>
  </div>

  <!-- TAB 2: SYLLABUS COVERAGE -->
  <div id="diary-pane-syllabus" class="diary-pane hidden space-y-6">
    <div class="card-base p-6 sm:p-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-hairline">
        <div>
          <h2 class="text-lg font-bold text-ink">Curriculum & Syllabus Progress Tracker</h2>
          <p class="text-xs text-slate-600 mt-0.5">Track unit progress and topic completion in real-time.</p>
        </div>
        <div class="flex items-center gap-3">
          <button onclick="openAddSyllabusModal()" class="btn-secondary text-xs py-2 px-3.5 inline-flex items-center gap-1.5 cursor-pointer">
            <Icon name="plus" size={13} />
            <span>Add Syllabus Unit</span>
          </button>
          <button
            onclick="window.showToast('Syllabus checkpoints saved successfully!', 'success')"
            class="btn-primary text-xs py-2 px-3.5 inline-flex items-center gap-1.5 cursor-pointer"
          >
            <Icon name="check" size={13} />
            <span>Save Checkpoints</span>
          </button>
        </div>
      </div>

      <div id="syllabus-container" class="space-y-6">
        {syllabusUnits && syllabusUnits.length > 0 ? (
          syllabusUnits.map((u: any) => (
            <div data-entry-id={u.id} data-search-text={`${u.unit_title}`} class="p-5 bg-surface rounded-2xl border border-hairline space-y-3 diary-entry-item">
              <div class="flex items-center justify-between">
                <span class="font-bold text-sm text-ink">{u.unit_title}</span>
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold font-mono text-brand-blue">{u.progress}% Completed</span>
                  <button onclick={`openEditSyllabusModal('${u.id}', '${encodeURIComponent(JSON.stringify(u))}')`} class="text-slate-400 hover:text-ink p-1 rounded hover:bg-slate-100 transition-colors" title="Edit unit">
                    <Icon name="edit" size={13} />
                  </button>
                  <button onclick={`confirmDeleteEntry('syllabus', '${u.id}')`} class="text-slate-400 hover:text-rose-600 p-1 rounded hover:bg-rose-50 transition-colors" title="Delete unit">
                    <Icon name="trash" size={13} />
                  </button>
                </div>
              </div>
              <div class="w-full bg-slate-200 h-2 rounded-full overflow-hidden">
                <div class="bg-brand-blue h-full rounded-full transition-all duration-300" style={`width: ${u.progress}%`}></div>
              </div>
              <div class="grid sm:grid-cols-2 gap-2 pt-2 text-xs">
                {Array.isArray(u.topics) && u.topics.map((t: any) => (
                  <label class="flex items-center gap-2 text-slate-700 cursor-pointer p-2.5 bg-white rounded-xl border border-hairline hover:border-hairline-strong shadow-card-subtle font-medium">
                    <input type="checkbox" checked={t.completed || u.progress >= 50} class="rounded text-ink accent-ink focus:ring-0" />
                    <span>{typeof t === 'string' ? t : t.name}</span>
                  </label>
                ))}
              </div>
            </div>
          ))
        ) : (
          <div id="syllabus-empty-state" class="py-12 text-center text-slate-400">
            <div class="w-12 h-12 rounded-2xl bg-surface border border-hairline flex items-center justify-center mx-auto text-slate-400 mb-2">
              <Icon name="analytics" size={24} />
            </div>
            <p class="text-xs font-semibold text-ink">No Syllabus Units Found</p>
            <p class="text-[11px] text-slate-500 mt-1">Add syllabus units and topics to monitor curriculum progress.</p>
            <button onclick="openAddSyllabusModal()" class="btn-primary text-xs py-2 px-4 inline-flex items-center gap-1.5 mt-3 cursor-pointer">
              <Icon name="plus" size={13} />
              <span>Add First Syllabus Unit</span>
            </button>
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- TAB 3: MENTORSHIP & REMARKS -->
  <div id="diary-pane-remarks" class="diary-pane hidden space-y-4">
    <div class="card-base p-6">
      <div class="flex items-center justify-between pb-4 border-b border-hairline mb-4">
        <div>
          <h2 class="font-bold text-base text-ink">Student Mentorship & Confidential Remarks Log</h2>
          <p class="text-xs text-slate-500">Track individual student guidance, behavioral logs, and commendations.</p>
        </div>
        <button onclick="openAddRemarkModal()" class="btn-primary text-xs py-2 px-3.5 inline-flex items-center gap-1.5 cursor-pointer">
          <Icon name="plus" size={13} />
          <span>Add Student Remark</span>
        </button>
      </div>

      <div id="remarks-container" class="space-y-3">
        {remarks && remarks.length > 0 ? (
          remarks.map((r: any) => (
            <div data-entry-id={r.id} data-search-text={`${r.student_name} ${r.category} ${r.notes}`} class="p-4 bg-surface rounded-2xl border border-hairline flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 diary-entry-item">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="font-bold text-xs text-ink">{r.student_name}</span>
                  <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-bold ${
                    r.type === 'positive' ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' :
                    r.type === 'warning' ? 'bg-amber-50 text-amber-800 border border-amber-200' :
                    'bg-indigo-50 text-brand-blue border border-indigo-200'
                  }`}>
                    {r.category}
                  </span>
                </div>
                <p class="text-xs text-slate-700">{r.notes}</p>
              </div>
              <div class="flex items-center gap-3 shrink-0">
                <span class="text-[11px] font-mono text-slate-500 font-medium">{r.remark_date}</span>
                <button onclick={`openEditRemarkModal('${r.id}', '${encodeURIComponent(JSON.stringify(r))}')`} class="text-slate-400 hover:text-ink p-1 rounded hover:bg-slate-100 transition-colors" title="Edit remark">
                  <Icon name="edit" size={13} />
                </button>
                <button onclick={`confirmDeleteEntry('remarks', '${r.id}')`} class="text-slate-400 hover:text-rose-600 p-1 rounded hover:bg-rose-50 transition-colors" title="Delete remark">
                  <Icon name="trash" size={13} />
                </button>
              </div>
            </div>
          ))
        ) : (
          <div id="remarks-empty-state" class="py-12 text-center text-slate-400">
            <div class="w-12 h-12 rounded-2xl bg-surface border border-hairline flex items-center justify-center mx-auto text-slate-400 mb-2">
              <Icon name="message-square" size={24} />
            </div>
            <p class="text-xs font-semibold text-ink">No Mentorship Remarks Logged</p>
            <p class="text-[11px] text-slate-500 mt-1">Log confidential student mentorship notes, warnings, and achievements.</p>
            <button onclick="openAddRemarkModal()" class="btn-primary text-xs py-2 px-4 inline-flex items-center gap-1.5 mt-3 cursor-pointer">
              <Icon name="plus" size={13} />
              <span>Add First Remark</span>
            </button>
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- TAB 4: TEACHING RESOURCES -->
  <div id="diary-pane-resources" class="diary-pane hidden space-y-4">
    <div class="card-base p-6">
      <div class="flex items-center justify-between pb-4 border-b border-hairline mb-6">
        <div>
          <h2 class="font-bold text-base text-ink">Course Materials Repository</h2>
          <p class="text-xs text-slate-500">Central cloud store for handouts, slides, lab guides, and syllabus documents.</p>
        </div>
        <button onclick="openAddMaterialModal()" class="btn-primary text-xs py-2 px-3.5 inline-flex items-center gap-1.5 cursor-pointer">
          <Icon name="plus" size={13} />
          <span>Add Course Material</span>
        </button>
      </div>

      <div id="materials-grid" class={resources && resources.length > 0 ? "grid sm:grid-cols-2 gap-4" : "space-y-4"}>
        {resources && resources.length > 0 ? (
          resources.map((res: any) => (
            <div data-entry-id={res.id} data-search-text={`${res.title} ${res.course_name} ${res.category}`} class="p-4 bg-surface rounded-2xl border border-hairline flex items-center justify-between text-xs hover:border-brand-blue transition-colors diary-entry-item">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-indigo-50 border border-indigo-200 flex items-center justify-center text-brand-blue shrink-0">
                  <Icon name="document" size={18} />
                </div>
                <div>
                  <div class="font-bold text-ink">{res.title}</div>
                  <div class="text-[10px] text-slate-500 mt-0.5">{res.course_name} • {res.category || 'Notes'} • {res.file_size}</div>
                </div>
              </div>
              <div class="flex items-center gap-1.5">
                <button onclick="window.showToast('Downloading course resource...', 'info')" class="p-1.5 text-slate-600 hover:text-ink bg-white hover:bg-surface rounded-xl border border-hairline shadow-card-subtle cursor-pointer" title="Download">
                  <Icon name="download" size={14} />
                </button>
                <button onclick={`openEditMaterialModal('${res.id}', '${encodeURIComponent(JSON.stringify(res))}')`} class="text-slate-400 hover:text-ink p-1 rounded hover:bg-slate-100 transition-colors" title="Edit">
                  <Icon name="edit" size={13} />
                </button>
                <button onclick={`confirmDeleteEntry('materials', '${res.id}')`} class="text-slate-400 hover:text-rose-600 p-1 rounded hover:bg-rose-50 transition-colors" title="Delete">
                  <Icon name="trash" size={13} />
                </button>
              </div>
            </div>
          ))
        ) : (
          <div id="materials-empty-state" class="py-12 text-center text-slate-400">
            <div class="w-12 h-12 rounded-2xl bg-surface border border-hairline flex items-center justify-center mx-auto text-slate-400 mb-2">
              <Icon name="folder" size={24} />
            </div>
            <p class="text-xs font-semibold text-ink">No Course Materials Uploaded</p>
            <p class="text-[11px] text-slate-500 mt-1">Upload slides, notes, and lab manuals for your courses.</p>
            <button onclick="openAddMaterialModal()" class="btn-primary text-xs py-2 px-4 inline-flex items-center gap-1.5 mt-3 cursor-pointer">
              <Icon name="plus" size={13} />
              <span>Upload Course Material</span>
            </button>
          </div>
        )}
      </div>
    </div>
  </div>

  <!-- TAB 5: RESEARCH & GRANTS -->
  <div id="diary-pane-research" class="diary-pane hidden space-y-4">
    <div class="card-base p-6">
      <div class="flex items-center justify-between pb-4 border-b border-hairline mb-6">
        <div>
          <h2 class="font-bold text-base text-ink">Academic Research & Grants Tracker</h2>
          <p class="text-xs text-slate-500">Track journal submissions, conference publications, and funded research grants.</p>
        </div>
        <button onclick="openAddResearchModal()" class="btn-primary text-xs py-2 px-3.5 inline-flex items-center gap-1.5 cursor-pointer">
          <Icon name="plus" size={13} />
          <span>Add Research & Grant</span>
        </button>
      </div>

      <div id="research-container" class="space-y-4">
        {researchPapers && researchPapers.length > 0 ? (
          researchPapers.map((paper: any) => (
            <div data-entry-id={paper.id} data-search-text={`${paper.title} ${paper.journal} ${paper.status}`} class="p-5 bg-surface rounded-2xl border border-hairline space-y-2 diary-entry-item">
              <div class="flex items-center justify-between">
                <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase ${
                  paper.status === 'Published' || paper.status === 'Granted' ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' :
                  paper.status === 'Accepted' ? 'bg-indigo-50 text-brand-blue border border-indigo-200' :
                  'bg-amber-50 text-amber-800 border border-amber-200'
                }`}>
                  {paper.status}
                </span>
                <div class="flex items-center gap-2">
                  <span class="text-xs font-mono text-brand-blue font-bold">
                    {typeof paper.citations === 'number' ? `${paper.citations} Citations` : paper.citations || '0 Citations'}
                  </span>
                  <button onclick={`openEditResearchModal('${paper.id}', '${encodeURIComponent(JSON.stringify(paper))}')`} class="text-slate-400 hover:text-ink p-1 rounded hover:bg-slate-100 transition-colors" title="Edit paper">
                    <Icon name="edit" size={13} />
                  </button>
                  <button onclick={`confirmDeleteEntry('research', '${paper.id}')`} class="text-slate-400 hover:text-rose-600 p-1 rounded hover:bg-rose-50 transition-colors" title="Delete paper">
                    <Icon name="trash" size={13} />
                  </button>
                </div>
              </div>
              <h3 class="font-bold text-sm text-ink">{paper.title}</h3>
              <div class="flex items-center justify-between text-xs text-slate-500 pt-1 font-medium">
                <span>{paper.journal}</span>
                <span class="font-mono text-[11px]">{paper.publication_date || ''}</span>
              </div>
            </div>
          ))
        ) : (
          <div id="research-empty-state" class="py-12 text-center text-slate-400">
            <div class="w-12 h-12 rounded-2xl bg-surface border border-hairline flex items-center justify-center mx-auto text-slate-400 mb-2">
