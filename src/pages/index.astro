---
import '../styles/global.css';
import { Show, UserButton } from '@clerk/astro/components';
import Icon from '../components/Icon.astro';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SynapseFlow — Give your workspace somewhere to go</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#dce3ea] text-slate-900 min-h-screen selection:bg-[#ffb703]/60 selection:text-black font-sans antialiased p-2 sm:p-4 md:p-6 lg:p-7">
    
    <!-- Outer Application Canvas Wrapper (Reference Design Window Style) -->
    <div class="max-w-[1680px] mx-auto bg-white rounded-[28px] sm:rounded-[40px] md:rounded-[48px] overflow-hidden shadow-2xl border border-slate-300/60 relative">

      <!-- ========================================== -->
      <!-- HERO SECTION (Exact Reference Screenshot Match) -->
      <!-- ========================================== -->
      <section class="relative min-h-[92vh] sm:min-h-[96vh] rounded-[24px] sm:rounded-[36px] md:rounded-[44px] m-2 sm:m-3 md:m-3.5 overflow-hidden flex flex-col justify-between text-white shadow-xl bg-[#1e40af]">
        <!-- Background Campus Horizon Artwork -->
        <div class="absolute inset-0 z-0">
          <img 
            src="/hero-fuji.png" 
            alt="SynapseFlow Workspace Horizon" 
            class="w-full h-full object-cover object-center transform scale-[1.01] transition-transform duration-1000"
          />
          <!-- Subtle vignette overlays to guarantee crisp typography contrast -->
          <div class="absolute inset-0 bg-gradient-to-b from-black/30 via-transparent to-black/40 pointer-events-none"></div>
          <div class="absolute inset-x-0 top-0 h-48 bg-gradient-to-b from-sky-950/40 via-sky-900/10 to-transparent pointer-events-none"></div>
        </div>

        <!-- TOP NAVIGATION BAR (Floating Pill Style over Azure Sky) -->
        <header class="relative z-30 w-full pt-6 sm:pt-8 px-6 sm:px-10 md:px-12 flex items-center justify-between">
          <!-- Logo & Brand (Ondro Style Typography) -->
          <a href="/" class="flex items-center gap-2.5 group cursor-pointer">
            <div class="w-8 h-8 rounded-xl bg-white/20 backdrop-blur-md border border-white/40 flex items-center justify-center text-white shadow-sm group-hover:scale-105 transition-transform">
              <Icon name="bolt" size={17} class="text-white fill-current" />
            </div>
            <div class="flex items-center gap-1.5">
              <span class="font-extrabold text-xl sm:text-2xl tracking-tight text-white drop-shadow-sm">SynapseFlow</span>
            </div>
          </a>

          <!-- Floating Centered Translucent Pill Menu -->
          <nav class="hidden md:flex items-center gap-1.5 bg-white/15 backdrop-blur-md border border-white/25 text-white/90 rounded-full px-6 py-2 shadow-sm text-xs font-medium hover:border-white/40 transition-all">
            <a href="#suite" class="px-3.5 py-1 rounded-full hover:text-white hover:bg-white/15 transition-all">Board</a>
            <a href="#workspaces" class="px-3.5 py-1 rounded-full hover:text-white hover:bg-white/15 transition-all">Solutions</a>
            <a href="#analytics" class="px-3.5 py-1 rounded-full hover:text-white hover:bg-white/15 transition-all">Analytics</a>
            <a href="#reviews" class="px-3.5 py-1 rounded-full hover:text-white hover:bg-white/15 transition-all">Community</a>
            <a href="#faq" class="px-3.5 py-1 rounded-full hover:text-white hover:bg-white/15 transition-all">FAQ</a>
          </nav>

          <!-- Right Action: Dark Pill Button -->
          <div class="flex items-center gap-3">
            <Show when="signed-out">
              <a href="/sign-in" class="hidden sm:inline-block text-xs font-semibold text-white/90 hover:text-white px-3 py-1.5 rounded-full hover:bg-white/10 transition-colors">
                Sign in
              </a>
              <a href="/sign-up" class="bg-black hover:bg-neutral-900 text-white font-medium text-xs sm:text-sm px-5 sm:px-6 py-2 sm:py-2.5 rounded-full shadow-lg hover:shadow-xl transition-all hover:scale-105 active:scale-95 flex items-center gap-1.5 cursor-pointer">
                <span>Get a demo</span>
              </a>
            </Show>
            <Show when="signed-in">
              <a href="/dashboard" class="bg-black hover:bg-neutral-900 text-white font-medium text-xs sm:text-sm px-5 sm:px-6 py-2 sm:py-2.5 rounded-full shadow-lg hover:shadow-xl transition-all hover:scale-105 active:scale-95 flex items-center gap-2 cursor-pointer">
                <span>Command Center</span>
                <Icon name="arrow-right" size={13} />
              </a>
              <div class="bg-white/20 p-1 rounded-full backdrop-blur-md border border-white/30">
                <UserButton />
              </div>
            </Show>
          </div>
        </header>

        <!-- HERO CENTERPIECE: Editorial Headline & Dual Action Buttons -->
        <div class="relative z-20 max-w-5xl mx-auto text-center px-4 sm:px-6 my-auto pt-8 sm:pt-14 pb-16">
          <!-- Main Display Headline (Give your workspace somewhere to go.) -->
          <h1 class="reveal-item text-4xl sm:text-6xl md:text-7xl lg:text-[84px] font-extrabold text-white tracking-tight leading-[1.05] mb-6 drop-shadow-[0_4px_24px_rgba(0,0,0,0.35)]">
            Give your <span class="font-serif-editorial italic font-normal tracking-normal text-white">workspace</span><br />
            somewhere to go.
          </h1>

          <!-- Subtitle -->
          <p class="reveal-item stagger-1 text-sm sm:text-base md:text-lg text-white/95 max-w-2xl mx-auto mb-10 leading-relaxed font-normal drop-shadow-[0_2px_10px_rgba(0,0,0,0.4)]">
            There’s more than one way to make something. Organize ideas, process high-fidelity documents, 
            score resumes with ATS intelligence, and turn scattered pieces into work that feels complete.
          </p>

          <!-- Dual Pill CTA Buttons (Exact Reference Screenshot Layout) -->
          <div class="reveal-item stagger-2 flex flex-col sm:flex-row items-center justify-center gap-3.5 sm:gap-4">
            <!-- Amber Golden Pill Button with Black Sparkle Icon -->
            <a href="/dashboard" class="w-full sm:w-auto bg-[#ffb703] hover:bg-[#ffa700] text-black font-semibold text-xs sm:text-sm px-6 sm:px-7 py-3 rounded-full flex items-center justify-center gap-3 shadow-xl hover:shadow-2xl transition-all hover:scale-105 active:scale-95 group cursor-pointer">
              <span>Start for free now</span>
              <span class="w-6 h-6 rounded-full bg-black text-[#ffb703] flex items-center justify-center group-hover:rotate-12 transition-transform shadow-sm">
                <Icon name="sparkles" size={12} class="text-[#ffb703] fill-current" />
              </span>
            </a>

            <!-- Translucent Glass Outline Pill Button -->
            <a href="#suite" class="w-full sm:w-auto bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/40 text-white font-medium text-xs sm:text-sm px-6 sm:px-7 py-3 rounded-full shadow-lg transition-all hover:scale-105 active:scale-95 flex items-center justify-center gap-2 cursor-pointer">
              <span>Explore the workspace</span>
            </a>
          </div>
        </div>

        <!-- Hero Bottom Atmospheric Base (Displays Village Skyline cleanly) -->
        <div class="relative z-10 w-full py-4 px-6 text-center text-[11px] text-white/70 font-mono flex items-center justify-between border-t border-white/10 backdrop-blur-sm bg-black/10">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>SynapseFlow OS 2.4 Active</span>
          </div>
          <div class="hidden sm:flex items-center gap-4 text-white/80">
            <span>PDF Engine • 300 DPI</span>
            <span>•</span>
            <span>ATS Radar • v4.2</span>
            <span>•</span>
            <span>Supabase Sync • &lt;20ms</span>
          </div>
          <a href="#suite" class="text-white hover:text-[#ffb703] transition-colors flex items-center gap-1 font-sans font-semibold">
            <span>Scroll to explore</span>
            <Icon name="chevron-down" size={12} />
          </a>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- TELEMETRY KPI RIBBON (Sleek Modern Glass Cards) -->
      <!-- ========================================== -->
      <section class="py-10 px-6 sm:px-12 max-w-7xl mx-auto">
        <div class="reveal-item grid grid-cols-2 md:grid-cols-4 gap-4 p-6 sm:p-8 bg-slate-50/80 border border-slate-200/80 rounded-[32px] shadow-sm">
          <div class="text-center p-2">
            <div class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-mono tracking-tight">99.98%</div>
            <div class="text-xs text-slate-500 font-semibold mt-1">Uptime Availability SLA</div>
          </div>
          <div class="text-center p-2 border-l border-slate-200">
            <div class="text-3xl sm:text-4xl font-extrabold text-[#2563eb] font-mono tracking-tight">7-in-1</div>
            <div class="text-xs text-slate-500 font-semibold mt-1">PDF Engine Tools</div>
          </div>
          <div class="text-center p-2 border-l border-slate-200">
            <div class="text-3xl sm:text-4xl font-extrabold text-[#0284c7] font-mono tracking-tight">&lt;20ms</div>
            <div class="text-xs text-slate-500 font-semibold mt-1">Client-side Latency</div>
          </div>
          <div class="text-center p-2 border-l border-slate-200">
            <div class="text-3xl sm:text-4xl font-extrabold text-emerald-700 font-mono tracking-tight">100%</div>
            <div class="text-xs text-slate-500 font-semibold mt-1">Privacy & Zero Data Leaks</div>
          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- UNIFIED WORKSPACE CANVAS & 3D INTERFACE SUITE -->
      <!-- ========================================== -->
      <section id="suite" class="py-16 px-6 sm:px-12 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-14">
          <div class="inline-flex items-center gap-2 bg-[#fff8e1] border border-[#ffb703]/50 rounded-full px-4 py-1.5 text-xs text-[#b45309] font-semibold mb-4 shadow-sm">
            <Icon name="sparkles" size={13} class="text-[#f59e0b]" />
            <span>Four Essential Workspaces in One Single Canvas</span>
          </div>
          <h2 class="reveal-item text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
            Work at the <span class="font-serif-editorial italic font-normal text-4xl sm:text-6xl text-[#2563eb]">speed of thought</span>
          </h2>
          <p class="reveal-item stagger-1 text-slate-600 mt-4 text-base sm:text-lg leading-relaxed">
            Eliminate fragmented tools. SynapseFlow unites high-performance PDF manipulation, AI ATS scoring, 
            campus attendance ledgers, and faculty diaries into one seamless command center.
          </p>
        </div>

        <!-- 3D Layered Canvas Container -->
        <div class="reveal-scale relative rounded-[36px] sm:rounded-[44px] p-6 sm:p-10 md:p-14 overflow-hidden shadow-2xl bg-gradient-to-br from-[#1e1b4b] via-[#312e81] to-[#4338ca] text-white border-4 border-white/20">
          <div class="absolute -top-24 -left-24 w-96 h-96 bg-[#ffb703]/20 rounded-full blur-3xl pointer-events-none"></div>
          <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-pink-500/20 rounded-full blur-3xl pointer-events-none"></div>
          <div class="absolute inset-0 bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:24px_24px] opacity-10"></div>

          <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
            
            <!-- Left Card: PDF Studio Live Compress -->
            <div class="lg:col-span-4 space-y-4 text-left">
              <div class="bg-white/10 backdrop-blur-xl border border-white/20 rounded-3xl p-5 shadow-2xl hover:scale-102 transition-transform">
                <div class="flex items-center justify-between mb-3">
                  <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-xl bg-rose-500/30 border border-rose-400/40 flex items-center justify-center text-rose-200">
                      <Icon name="pdf" size={16} />
                    </div>
                    <div>
                      <div class="text-xs font-bold text-white">PDF Power Studio</div>
                      <div class="text-[10px] text-white/70">Lossless 300 DPI Engine</div>
                    </div>
                  </div>
                  <span class="text-[10px] font-mono bg-emerald-400/20 text-emerald-300 border border-emerald-400/30 px-2 py-0.5 rounded-full font-bold">
                    -85% Reduced
                  </span>
                </div>
                <div class="bg-black/20 rounded-2xl p-3 border border-white/10 space-y-2">
                  <div class="flex justify-between text-[11px] text-white/80 font-mono">
                    <span>Compressing Syllabus.pdf</span>
                    <span class="text-[#ffb703] font-bold">14.8MB → 2.2MB</span>
                  </div>
                  <div class="w-full bg-white/20 h-1.5 rounded-full overflow-hidden">
                    <div class="bg-[#ffb703] h-full w-[85%] rounded-full animate-pulse"></div>
                  </div>
                </div>
              </div>

              <!-- Attendance Sync Mini Card -->
              <div class="bg-white/10 backdrop-blur-xl border border-white/20 rounded-3xl p-5 shadow-2xl hover:scale-102 transition-transform">
                <div class="flex items-center justify-between mb-2">
                  <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-xl bg-amber-500/30 border border-amber-400/40 flex items-center justify-center text-amber-200">
                      <Icon name="attendance" size={16} />
                    </div>
                    <div>
                      <div class="text-xs font-bold text-white">Classroom Ledger</div>
                      <div class="text-[10px] text-white/70">CS-301 Algorithms</div>
                    </div>
                  </div>
                  <span class="text-xs font-mono font-extrabold text-emerald-300">94.2% Present</span>
                </div>
                <div class="flex items-center gap-1.5 pt-1">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                  <span class="text-[10px] text-white/80 font-mono">Supabase Real-Time Synced</span>
                </div>
              </div>
            </div>

            <!-- Center Showcase: Giant ATS Score Radar Card -->
            <div class="lg:col-span-4 flex flex-col items-center justify-center p-6 bg-white/15 backdrop-blur-2xl border border-white/30 rounded-[36px] shadow-2xl relative text-center">
              <div class="w-32 h-32 rounded-full bg-white/10 border-4 border-white/30 flex flex-col items-center justify-center mb-4 shadow-inner relative">
                <div class="absolute inset-2 rounded-full border-2 border-dashed border-white/40 animate-spin" style="animation-duration: 20s;"></div>
                <span class="text-4xl font-extrabold font-mono text-white tracking-tight">92</span>
                <span class="text-[10px] text-[#ffb703] uppercase font-bold tracking-widest">ATS Match</span>
              </div>
              <h4 class="text-base font-extrabold text-white mb-1">Resume Intelligence</h4>
              <p class="text-xs text-white/80 text-center mb-4 max-w-xs">Optimal keyword density & action verb telemetry computed instantly.</p>
              <div class="flex flex-wrap gap-1.5 justify-center">
                <span class="px-2.5 py-1 rounded-full bg-emerald-500/30 border border-emerald-400/40 text-[10px] font-bold text-white">#TypeScript</span>
                <span class="px-2.5 py-1 rounded-full bg-emerald-500/30 border border-emerald-400/40 text-[10px] font-bold text-white">#React</span>
                <span class="px-2.5 py-1 rounded-full bg-[#ffb703]/30 border border-[#ffb703]/40 text-[10px] font-bold text-white">#CloudArch</span>
              </div>
            </div>

            <!-- Right Card: Faculty Diary Schedule -->
            <div class="lg:col-span-4 space-y-4 text-left">
              <div class="bg-white/10 backdrop-blur-xl border border-white/20 rounded-3xl p-5 shadow-2xl hover:scale-102 transition-transform">
                <div class="flex items-center justify-between mb-3">
                  <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-xl bg-indigo-500/30 border border-indigo-400/40 flex items-center justify-center text-indigo-200">
                      <Icon name="diary" size={16} />
                    </div>
                    <div>
                      <div class="text-xs font-bold text-white">Academic Diary</div>
                      <div class="text-[10px] text-white/70">Weekly Timetable & Syllabus</div>
                    </div>
                  </div>
                  <span class="text-[10px] font-mono bg-white/20 text-white px-2 py-0.5 rounded-full font-bold">Active</span>
                </div>
                <div class="space-y-1.5 text-xs text-white/90">
                  <div class="flex items-center justify-between bg-black/20 px-3 py-2 rounded-xl border border-white/10">
                    <span class="font-semibold text-[11px]">Next: CS-402 Lecture</span>
                    <span class="font-mono text-[10px] text-[#ffb703] font-bold">14:00 - 15:30</span>
                  </div>
                  <div class="flex items-center justify-between bg-black/20 px-3 py-2 rounded-xl border border-white/10">
                    <span class="font-semibold text-[11px]">Syllabus Completion</span>
                    <span class="font-mono text-[10px] text-emerald-300 font-bold">87.5%</span>
                  </div>
                </div>
              </div>

              <!-- Quick Telemetry Box -->
              <div class="bg-white/10 backdrop-blur-xl border border-white/20 rounded-3xl p-5 shadow-2xl hover:scale-102 transition-transform flex items-center justify-between">
                <div>
                  <div class="text-[10px] uppercase font-bold text-white/70">Engine Latency</div>
                  <div class="text-xl font-extrabold font-mono text-white">&lt;20ms Pure WASM</div>
                </div>
                <div class="w-10 h-10 rounded-2xl bg-white/20 border border-white/30 flex items-center justify-center text-[#ffb703]">
                  <Icon name="bolt" size={20} />
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- ========================================== -->
      <!-- ADVANCED ANALYTICS & REPORTING BENTO (Wollo + Ondro Aesthetic) -->
      <!-- ========================================== -->
      <section id="analytics" class="py-20 px-6 sm:px-12 max-w-7xl mx-auto">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-widest bg-slate-100 border border-slate-200 px-3.5 py-1 rounded-full">
            Real-time Telemetry
          </span>
          <h2 class="reveal-item text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mt-3">
            Advanced <span class="font-serif-editorial italic font-normal text-4xl sm:text-6xl text-slate-900">Analytics</span> & Reporting
          </h2>
          <p class="reveal-item stagger-1 text-slate-600 mt-3 text-sm sm:text-base">
            Gain deep visibility into document conversions, ATS compliance rates, and classroom engagement scores.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
          <!-- Left Bento Card: Interactive Tag Cloud -->
          <div class="reveal-item lg:col-span-5 bg-slate-50/70 border border-slate-200/80 rounded-[36px] p-8 flex flex-col justify-between shadow-sm hover:shadow-md transition-shadow relative overflow-hidden">
            <div>
              <div class="w-10 h-10 rounded-2xl bg-slate-200/60 flex items-center justify-center text-slate-800 mb-6">
                <Icon name="tag" size={20} />
              </div>
              <h3 class="text-2xl font-bold text-slate-900 tracking-tight mb-2">Automated Categorization</h3>
              <p class="text-xs text-slate-600 mb-8 leading-relaxed">
                Smart indexing engine tags and routes all document streams and academic records instantly.
              </p>

              <!-- Dynamic Angled Tag Cloud -->
              <div class="flex flex-wrap gap-2.5 py-4">
                <span class="px-4 py-2 rounded-2xl bg-[#ffb703] text-black font-bold text-xs shadow-sm transform -rotate-3 hover:rotate-0 transition-transform">#PDFMerge</span>
                <span class="px-4 py-2 rounded-2xl bg-sky-100 text-sky-900 font-bold text-xs border border-sky-200 transform rotate-2 hover:rotate-0 transition-transform">#ATSScore92</span>
                <span class="px-4 py-2 rounded-2xl bg-indigo-100 text-indigo-900 font-bold text-xs border border-indigo-200 transform -rotate-1 hover:rotate-0 transition-transform">#AttendanceSync</span>
                <span class="px-4 py-2 rounded-2xl bg-emerald-100 text-emerald-900 font-bold text-xs border border-emerald-200 transform rotate-3 hover:rotate-0 transition-transform">#TimetableCS</span>
                <span class="px-4 py-2 rounded-2xl bg-purple-100 text-purple-900 font-bold text-xs border border-purple-200 transform -rotate-2 hover:rotate-0 transition-transform">#OCRScan</span>
                <span class="px-4 py-2 rounded-2xl bg-rose-100 text-rose-900 font-bold text-xs border border-rose-200 transform rotate-1 hover:rotate-0 transition-transform">#WatermarkProtect</span>
                <span class="px-4 py-2 rounded-2xl bg-amber-100 text-amber-900 font-bold text-xs border border-amber-200 transform -rotate-3 hover:rotate-0 transition-transform">#SyllabusTracker</span>
              </div>
            </div>

            <!-- Tri-Color Bottom Accent Indicator -->
            <div class="flex items-center gap-2 pt-6 mt-6 border-t border-slate-200">
              <span class="h-2 w-10 rounded-full bg-[#ffb703]"></span>
              <span class="h-2 w-14 rounded-full bg-[#2563eb]"></span>
              <span class="h-2 w-8 rounded-full bg-emerald-500"></span>
              <span class="text-[11px] font-mono text-slate-500 ml-auto">100% Client Native</span>
            </div>
          </div>

          <!-- Right Bento Card: Interactive Bezier Trend Chart -->
          <div class="reveal-item stagger-2 lg:col-span-7 bg-slate-50/70 border border-slate-200/80 rounded-[36px] p-8 flex flex-col justify-between shadow-sm hover:shadow-md transition-shadow">
            <div>
              <!-- Top Header & Timeframe Switcher -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                <div>
                  <h3 class="text-2xl font-bold text-slate-900 tracking-tight">Performance Throughput</h3>
                  <p class="text-xs text-slate-500">Velocity benchmarks across processing pipelines</p>
                </div>
                
                <!-- Interactive Timeframe Filter Buttons -->
                <div class="flex items-center bg-white border border-slate-200 rounded-full p-1 shadow-sm text-xs font-semibold" id="timeframe-buttons">
                  <button type="button" data-timeframe="3d" class="tf-btn px-3 py-1 rounded-full text-slate-600 hover:text-black transition-colors">3d</button>
                  <button type="button" data-timeframe="1w" class="tf-btn px-3 py-1 rounded-full text-slate-600 hover:text-black transition-colors">1w</button>
                  <button type="button" data-timeframe="1m" class="tf-btn px-3 py-1 rounded-full bg-black text-white shadow-sm">1m</button>
                  <button type="button" data-timeframe="3m" class="tf-btn px-3 py-1 rounded-full text-slate-600 hover:text-black transition-colors">3m</button>
                  <button type="button" data-timeframe="6m" class="tf-btn px-3 py-1 rounded-full text-slate-600 hover:text-black transition-colors">6m</button>
                  <button type="button" data-timeframe="1y" class="tf-btn px-3 py-1 rounded-full text-slate-600 hover:text-black transition-colors">1y</button>
                </div>
              </div>

              <!-- Dual Metric Highlights -->
              <div class="grid grid-cols-2 gap-4 mb-6">
                <div class="bg-[#fff8e1] border border-[#ffb703]/50 rounded-2xl p-4">
                  <div class="text-[11px] font-bold text-[#b45309] uppercase tracking-wider">ATS Score Velocity</div>
                  <div class="text-2xl font-extrabold text-slate-900 font-mono mt-0.5" id="metric-ats">+36.4%</div>
                  <div class="text-[10px] text-slate-600 mt-1">Faster candidate shortlisting</div>
                </div>
                <div class="bg-indigo-50 border border-indigo-200 rounded-2xl p-4">
                  <div class="text-[11px] font-bold text-indigo-800 uppercase tracking-wider">Document Throughput</div>
                  <div class="text-2xl font-extrabold text-slate-900 font-mono mt-0.5" id="metric-docs">+52.8%</div>
