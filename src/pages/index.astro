    <!-- CLIENT INTERACTIVE SCRIPTS -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        // 1. Scroll-to-Reveal Animation Engine
        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
            }
          });
        }, {
          threshold: 0.12,
          rootMargin: '0px 0px -40px 0px'
        });

        document.querySelectorAll('.reveal-item, .reveal-scale').forEach(el => {
          revealObserver.observe(el);
        });

        // 2. Interactive Timeframe Bezier Chart Switcher
        const timeframeData = {
          '3d': { line: 'M 0,140 Q 120,120 220,90 T 360,70 T 500,30', fill: 'M 0,140 Q 120,120 220,90 T 360,70 T 500,30 L 500,160 L 0,160 Z', ats: '+18.2%', docs: '+24.5%' },
          '1w': { line: 'M 0,135 Q 110,115 200,75 T 350,55 T 500,20', fill: 'M 0,135 Q 110,115 200,75 T 350,55 T 500,20 L 500,160 L 0,160 Z', ats: '+26.8%', docs: '+38.1%' },
          '1m': { line: 'M 0,130 Q 100,110 180,60 T 340,40 T 500,10', fill: 'M 0,130 Q 100,110 180,60 T 340,40 T 500,10 L 500,160 L 0,160 Z', ats: '+36.4%', docs: '+52.8%' },
          '3m': { line: 'M 0,125 Q 90,95 170,50 T 330,30 T 500,5', fill: 'M 0,125 Q 90,95 170,50 T 330,30 T 500,5 L 500,160 L 0,160 Z', ats: '+48.9%', docs: '+68.4%' },
          '6m': { line: 'M 0,110 Q 80,80 160,40 T 320,20 T 500,2', fill: 'M 0,110 Q 80,80 160,40 T 320,20 T 500,2 L 500,160 L 0,160 Z', ats: '+64.2%', docs: '+82.0%' },
          '1y': { line: 'M 0,95 Q 70,60 150,30 T 310,10 T 500,0', fill: 'M 0,95 Q 70,60 150,30 T 310,10 T 500,0 L 500,160 L 0,160 Z', ats: '+91.5%', docs: '+124.7%' }
        };

        const tfButtons = document.querySelectorAll('.tf-btn');
        const chartLine = document.getElementById('chart-line-path');
        const chartFill = document.getElementById('chart-fill-path');
        const metricAts = document.getElementById('metric-ats');
        const metricDocs = document.getElementById('metric-docs');

        tfButtons.forEach(btn => {
          btn.addEventListener('click', () => {
            tfButtons.forEach(b => {
              b.classList.remove('bg-black', 'text-white', 'shadow-sm');
              b.classList.add('text-slate-600');
            });
            btn.classList.add('bg-black', 'text-white', 'shadow-sm');
            btn.classList.remove('text-slate-600');

            const tf = btn.getAttribute('data-timeframe');
            const data = timeframeData[tf];
            if (data && chartLine && chartFill) {
              chartLine.setAttribute('d', data.line);
              chartFill.setAttribute('d', data.fill);
              if (metricAts) metricAts.textContent = data.ats;
              if (metricDocs) metricDocs.textContent = data.docs;
            }
          });
        });

        // 3. Interactive Sandbox Switcher
        const sbTabs = document.querySelectorAll('.sb-tab');
        const sbContents = document.querySelectorAll('.sandbox-content');

        sbTabs.forEach(tab => {
          tab.addEventListener('click', () => {
            const targetId = `tab-${tab.getAttribute('data-tab')}`;
            sbTabs.forEach(t => {
              t.classList.remove('bg-black', 'text-white', 'shadow-sm');
              t.classList.add('bg-slate-100', 'text-slate-600');
            });
            tab.classList.add('bg-black', 'text-white', 'shadow-sm');
            tab.classList.remove('bg-slate-100', 'text-slate-600');

            sbContents.forEach(c => {
              if (c.id === targetId) {
                c.classList.remove('hidden');
                c.classList.add('block');
              } else {
                c.classList.add('hidden');
                c.classList.remove('block');
              }
            });
          });
        });

        // 4. Sandbox ATS Calculation Simulator
        const btnAnalyze = document.getElementById('sim-btn-analyze');
        if (btnAnalyze) {
          btnAnalyze.addEventListener('click', () => {
            const scoreEl = document.getElementById('sim-score');
            const verdictEl = document.getElementById('sim-verdict');
            if (scoreEl && verdictEl) {
              scoreEl.innerHTML = '<span class="text-3xl text-slate-400 animate-pulse">Calculating...</span>';
              setTimeout(() => {
                const randomScore = Math.floor(Math.random() * 8) + 88;
                scoreEl.innerHTML = `${randomScore}<span class="text-2xl text-slate-400">/100</span>`;
                verdictEl.textContent = randomScore > 90 ? 'Exceptional Candidate Match' : 'Strong Alignment Found';
              }, 450);
            }
          });
        }

        // 5. PDF Compression Mode Switcher
        const pdfBtns = document.querySelectorAll('.pdf-comp-btn');
        const pdfSizeEl = document.getElementById('sim-pdf-size');
        pdfBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            pdfBtns.forEach(b => {
              b.classList.remove('bg-black', 'text-white');
              b.classList.add('bg-slate-100', 'text-slate-700');
            });
            btn.classList.add('bg-black', 'text-white');
            btn.classList.remove('bg-slate-100', 'text-slate-700');

            const ratio = btn.getAttribute('data-ratio');
            if (pdfSizeEl) {
              if (ratio === '85') pdfSizeEl.textContent = '2.76 MB (-85% reduction)';
              else if (ratio === '60') pdfSizeEl.textContent = '7.36 MB (-60% reduction)';
              else pdfSizeEl.textContent = '12.88 MB (-30% reduction)';
            }
          });
        });

        // 6. FAQ Accordion Handler
        document.querySelectorAll('.faq-toggle').forEach(btn => {
          btn.addEventListener('click', () => {
            const content = btn.nextElementSibling;
            const icon = btn.querySelector('svg');
            if (content) {
              const isHidden = content.classList.contains('hidden');
              content.classList.toggle('hidden', !isHidden);
              if (icon) {
                icon.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
              }
            }
          });
        });
      });
    </script>
  </body>
