---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchStudents, fetchCourses, fetchAtsScans, fetchPdfActivities, fetchFacultyRemarks } from '../lib/supabase';

const [students, courses, atsScans, pdfActivities, remarks] = await Promise.all([
  fetchStudents(),
  fetchCourses(),
  fetchAtsScans(),
  fetchPdfActivities(),
  fetchFacultyRemarks(),
]);

const stats = [
  {
    title: 'PDFs Processed',
    value: pdfActivities.length.toString(),
    change: '+18.4%',
    changeType: 'up',
    detail: 'Logged in Supabase DB',
    icon: '📄',
    bgColor: 'bg-indigo-50',
    textColor: 'text-brand-blue',
  },
  {
    title: 'ATS Resumes Checked',
    value: atsScans.length.toString(),
    change: '+12.1%',
    changeType: 'up',
    detail: `Avg score: ${atsScans.length ? Math.round(atsScans.reduce((acc, s) => acc + s.score, 0) / atsScans.length) : 0}/100`,
    icon: '🎯',
    bgColor: 'bg-teal-50',
    textColor: 'text-brand-moss-dark',
  },
  {
    title: 'Students Enrolled',
    value: students.length.toString(),
    change: '92.4%',
    changeType: 'rate',
    detail: `Across ${courses.length} active courses in Supabase`,
    icon: '📋',
    bgColor: 'bg-yellow-50',
    textColor: 'text-brand-yellow-dark',
  },
  {
    title: 'Faculty Remarks & Diary',
    value: remarks.length.toString(),
    change: 'Live DB',
    changeType: 'info',
    detail: 'Recorded in Supabase',
    icon: '📚',
    bgColor: 'bg-rose-50',
    textColor: 'text-brand-coral-dark',
  },
];

const quickTools = [
  {
    title: 'Merge & Compress PDFs',
    desc: 'Combine chapters or shrink lecture slides',
    icon: '📄',
    href: '/pdf-tools',
    tag: 'PDF Studio',
    tagColor: 'bg-indigo-50 text-brand-blue border-indigo-200',
  },
  {
    title: 'Scan Resume against JD',
    desc: 'Instant ATS compatibility scoring & suggestions',
    icon: '🎯',
    href: '/ats-checker',
    tag: 'ATS Intelligence',
    tagColor: 'bg-teal-50 text-brand-moss-dark border-teal-200',
  },
  {
    title: 'Mark Today\'s Attendance',
    desc: 'Record presence for CS-301 Data Structures',
    icon: '📋',
    href: '/attendance',
    tag: 'Campus Manager',
    tagColor: 'bg-brand-yellow-light text-brand-yellow-dark border-brand-yellow/40',
  },
  {
    title: 'Faculty Timetable & Plans',
    desc: 'Manage weekly schedule & lecture remarks',
    icon: '📚',
    href: '/faculty-diary',
    tag: 'Academic Diary',
    tagColor: 'bg-rose-50 text-brand-coral-dark border-rose-200',
  },
];

const activities = [
  { tool: 'PDF Studio', action: 'Merged 4 chapter PDFs into "CS301_Complete_Notes.pdf"', time: '4 min ago', status: 'Completed', type: 'pdf' },
  { tool: 'ATS AI', action: 'Analyzed resume "Alex_FullStack_2026.pdf" for Senior SRE Role (Score: 89)', time: '19 min ago', status: 'High Match', type: 'ats' },
  { tool: 'Attendance', action: 'Synchronized class roster for CS-302 Algorithms (42 Present, 3 Absent)', time: '1 hour ago', status: 'Synced', type: 'attendance' },
  { tool: 'Faculty Diary', action: 'Added lecture topic "B-Trees & Indexing" for upcoming session', time: '3 hours ago', status: 'Scheduled', type: 'faculty' },
  { tool: 'PDF Studio', action: 'Compressed research submission from 24.1 MB to 3.8 MB (-84%)', time: '5 hours ago', status: 'Optimized', type: 'pdf' },
];
---

<BaseLayout title="Command Center" activePage="dashboard">
  <!-- Welcome Banner -->
  <div class="card-base p-6 sm:p-8 mb-8 relative overflow-hidden bg-white shadow-card-subtle">
    <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-yellow-light border border-brand-yellow/40 text-xs text-brand-yellow-dark font-semibold mb-3">
          <span class="w-2 h-2 rounded-full bg-brand-yellow-deep animate-pulse"></span>
          <span>Workspace Active • SynapseFlow OS Pro</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-ink tracking-tight">
          Welcome back, Dr. Sujoy Moulick
        </h1>
        <p class="text-slate-600 text-sm mt-1.5 max-w-2xl">
          Here is your unified productivity overview across PDF tools, ATS scoring, classroom attendance, and academic diary operations.
        </p>
      </div>

      <div class="flex items-center gap-3 w-full md:w-auto">
        <button
          onclick="window.showToast('Workspace data snapshot generated successfully!', 'info')"
          class="btn-secondary"
        >
          <span>📥</span>
          <span class="ml-1.5">Export Snapshot</span>
        </button>
        <a
          href="/pdf-tools"
          class="btn-primary"
        >
          <span>+ Quick Action</span>
        </a>
      </div>
    </div>
  </div>

  <!-- 4 High-Impact KPI Stat Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    {stats.map((item) => (
      <div class="card-hover p-5 relative overflow-hidden">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-semibold text-slate-500">{item.title}</span>
          <span class={`text-xl p-2 rounded-xl ${item.bgColor} border border-hairline-soft`}>{item.icon}</span>
        </div>
        <div class="flex items-baseline gap-2 mb-1">
          <span class="text-3xl font-extrabold text-ink">{item.value}</span>
          <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
            {item.change}
          </span>
        </div>
        <div class="text-[11px] text-slate-500">{item.detail}</div>
      </div>
    ))}
  </div>

  <!-- Supercharged Workspaces Hub -->
  <div class="mb-8">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 class="text-lg font-bold text-ink flex items-center gap-2">
          <span>⚡</span> Supercharged Workspaces
        </h2>
        <p class="text-xs text-slate-500">Direct shortcuts to execute high-velocity tasks</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {quickTools.map((tool) => (
        <a
          href={tool.href}
          class="card-hover p-5 flex flex-col justify-between group cursor-pointer"
        >
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-2xl group-hover:scale-110 transition-transform">{tool.icon}</span>
              <span class={`text-[10px] font-bold px-2.5 py-0.5 rounded-full border ${tool.tagColor}`}>
                {tool.tag}
              </span>
            </div>
            <h3 class="font-bold text-sm text-ink group-hover:text-brand-blue transition-colors mb-1">
              {tool.title}
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">{tool.desc}</p>
          </div>
          <div class="mt-4 pt-3 border-t border-hairline flex items-center justify-between text-xs text-brand-blue font-semibold">
            <span>Launch Tool</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- Interactive Sandbox Row -->
  <div class="grid lg:grid-cols-3 gap-6 mb-8">
    <!-- Left: Quick PDF Sandbox -->
    <div class="card-base p-6 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <span class="text-lg">📄</span>
            <h3 class="font-bold text-sm text-ink">Quick PDF Dropzone</h3>
          </div>
          <span class="text-[10px] bg-indigo-50 text-brand-blue border border-indigo-200 px-2 py-0.5 rounded-full font-bold">Instant Action</span>
        </div>
        <p class="text-xs text-slate-600 mb-4">Drop a PDF here for 1-click compression or stamp</p>

        <div
          id="dash-pdf-drop"
          class="border-2 border-dashed border-hairline-strong hover:border-brand-blue rounded-2xl p-6 text-center cursor-pointer transition-colors bg-surface mb-4"
        >
          <div class="text-2xl mb-1">📥</div>
          <p class="text-xs font-bold text-ink">Drop PDF here or click</p>
          <p class="text-[10px] text-slate-500 mt-0.5">Supports PDF up to 50 MB</p>
        </div>

        <div id="dash-pdf-progress" class="hidden space-y-2 mb-4">
          <div class="flex justify-between text-xs text-slate-700">
            <span>Optimizing document...</span>
            <span class="font-mono text-brand-blue font-bold">84%</span>
          </div>
          <div class="w-full bg-surface h-2 rounded-full overflow-hidden border border-hairline">
            <div class="bg-brand-blue h-full w-[84%] animate-pulse"></div>
          </div>
        </div>
      </div>

      <button
        id="dash-pdf-btn"
        class="btn-primary w-full"
      >
        Simulate Quick Compress (-82%)
      </button>
    </div>

    <!-- Center: Quick ATS Analyzer -->
    <div class="card-base p-6 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <span class="text-lg">🎯</span>
            <h3 class="font-bold text-sm text-ink">Quick ATS Score Checker</h3>
          </div>
          <span class="text-[10px] bg-teal-50 text-brand-moss-dark border border-teal-200 px-2 py-0.5 rounded-full font-bold">AI Engine</span>
        </div>
        <p class="text-xs text-slate-600 mb-3">Simulate candidate CV score against typical job descriptions</p>

        <div class="p-3.5 bg-surface rounded-xl border border-hairline space-y-2 mb-4">
          <div class="flex justify-between items-center text-xs">
            <span class="text-slate-500 font-medium">Candidate:</span>
            <span class="font-bold text-ink">Alex Rivera (Staff Eng)</span>
          </div>
          <div class="flex justify-between items-center text-xs">
            <span class="text-slate-500 font-medium">Role Target:</span>
            <span class="text-brand-blue font-semibold">Cloud Architect</span>
          </div>
          <div class="pt-2 border-t border-hairline flex items-center justify-between">
            <span class="text-xs font-bold text-slate-700">Predicted Score:</span>
            <span class="text-sm font-extrabold text-brand-moss-dark bg-teal-50 border border-teal-200 px-2.5 py-0.5 rounded-full font-mono">87 / 100</span>
          </div>
        </div>
      </div>

      <a
        href="/ats-checker"
        class="btn-blue w-full text-center"
      >
        Open Full ATS Studio →
      </a>
    </div>

    <!-- Right: Next Class Countdown -->
    <div class="card-base p-6 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <span class="text-lg">📋</span>
            <h3 class="font-bold text-sm text-ink">Today's Class Session</h3>
          </div>
          <span class="text-[10px] bg-brand-yellow-light text-brand-yellow-dark border border-brand-yellow/40 px-2 py-0.5 rounded-full font-bold">Upcoming</span>
        </div>
        <p class="text-xs text-slate-600 mb-3">CS-301 Data Structures & Algorithms</p>

        <div class="p-3.5 bg-surface rounded-xl border border-hairline space-y-2 mb-4 text-xs">
          <div class="flex justify-between">
            <span class="text-slate-500 font-medium">Time & Room:</span>
            <span class="font-semibold text-ink">11:00 AM • Lab 3B</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500 font-medium">Enrolled Students:</span>
            <span class="text-emerald-700 font-mono font-bold">45 Students</span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-500 font-medium">Planned Topic:</span>
            <span class="text-ink font-medium">Red-Black Trees</span>
          </div>
        </div>
      </div>

      <a
        href="/attendance"
        class="btn-primary w-full text-center"
      >
        Take Class Attendance →
      </a>
    </div>
  </div>

  <!-- Unified Recent Activity Feed (DESIGN.md comparison-table / comparison-row) -->
  <div class="card-base p-6">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-hairline mb-4">
      <div>
        <h2 class="font-bold text-base text-ink flex items-center gap-2">
          <span>🕒</span> Unified Activity Feed
        </h2>
        <p class="text-xs text-slate-500">Live operational events synchronized across the platform</p>
      </div>

      <div class="flex items-center gap-2 text-xs">
        <span class="px-3 py-1 bg-ink text-white rounded-full font-semibold shadow-sm">All Logs</span>
        <span class="px-3 py-1 bg-surface text-slate-600 border border-hairline rounded-full hover:text-ink cursor-pointer">PDF</span>
        <span class="px-3 py-1 bg-surface text-slate-600 border border-hairline rounded-full hover:text-ink cursor-pointer">ATS</span>
        <span class="px-3 py-1 bg-surface text-slate-600 border border-hairline rounded-full hover:text-ink cursor-pointer">Campus</span>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead>
          <tr class="text-slate-500 bg-surface border-b border-hairline">
            <th class="py-3 px-4 font-semibold">Workspace</th>
            <th class="py-3 px-4 font-semibold">Action Performed</th>
            <th class="py-3 px-4 font-semibold">Status</th>
            <th class="py-3 px-4 font-semibold text-right">Time</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline-soft">
          {activities.map((act) => (
            <tr class="hover:bg-surface/60 transition-colors">
              <td class="py-3 px-4">
                <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold ${
                  act.type === 'pdf' ? 'bg-indigo-50 text-brand-blue border border-indigo-200' :
                  act.type === 'ats' ? 'bg-teal-50 text-brand-moss-dark border border-teal-200' :
                  act.type === 'attendance' ? 'bg-brand-yellow-light text-brand-yellow-dark border border-brand-yellow/40' :
                  'bg-rose-50 text-brand-coral-dark border border-rose-200'
                }`}>
                  {act.tool}
                </span>
              </td>
              <td class="py-3 px-4 text-ink font-medium">{act.action}</td>
              <td class="py-3 px-4">
                <span class="text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-full text-[10px] font-bold">
                  {act.status}
                </span>
              </td>
              <td class="py-3 px-4 text-right text-slate-500 font-mono text-[11px]">{act.time}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  const pdfBtn = document.getElementById('dash-pdf-btn');
  const pdfProgress = document.getElementById('dash-pdf-progress');
  const pdfDrop = document.getElementById('dash-pdf-drop');

  pdfBtn?.addEventListener('click', () => {
    pdfProgress?.classList.remove('hidden');
    pdfDrop?.classList.add('opacity-50');
    setTimeout(() => {
      window.showToast('Document compressed from 18.2 MB to 3.1 MB (-83%)!', 'success');
      pdfProgress?.classList.add('hidden');
      pdfDrop?.classList.remove('opacity-50');
    }, 1200);
  });
</script>
